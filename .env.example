# Dotenv template. Copy it to .env.local (every environment) or to
# .env.dev.local, .env.stg.local, .env.prod.local (one
# environment) and fill in the values. git ignores every *.local file; .env,
# .env.$APP_ENV, and this template are committed and carry no secret.
#
# At startup .env is read first, then .env.local, then .env.$APP_ENV, then
# .env.$APP_ENV.local, then every file under /run/secrets, then the
# process environment, and a later source wins. A variable exported in the
# shell or set by the platform therefore always beats a file.
#
# APP_ENV itself is read from the process, then from .env and .env.local; it
# selects the second pair, so it cannot be set there. Uncomment to pin this
# checkout:
#
# APP_ENV=dev
#
# The full variable list of this build, including your own [app] keys:
#
#   ./scrumify --generate-config env

# the database DSN config.prod.toml references as ${DATABASE_URL}; config.dev.toml carries the development one as a literal
DATABASE_URL=

# base64 secret signing and sealing everything the browser carries: openssl rand -base64 32
SESSION_KEYRING_SECRET=

# the OpenID provider's issuer URL
AUTH_OIDC_ISSUER=

# the client registered with that provider
AUTH_OIDC_CLIENT_ID=

# that client's secret
AUTH_OIDC_CLIENT_SECRET=
